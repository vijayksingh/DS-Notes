---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DS Notes",
  description = "Problem-by-problem data-structure flashcards for intuition, gotchas, and review.",
} = Astro.props;

import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
