---
import { problems } from "../data/problems.js";

const [initialProblem] = problems;
const sourceLabel = initialProblem.source.name.split(":")[0] ?? initialProblem.source.name;
const canonical = initialProblem.canonical;
const initialCard = initialProblem.cards[0];
---

<main class="shell">
  <aside class="sidebar" aria-label="Problem index">
    <details class="index-panel" id="indexPanel" open>
      <summary class="index-summary">
        <span>
          <span class="label">Index</span>
          <strong id="indexCurrentProblem">{initialProblem.title}</strong>
        </span>
        <span class="index-summary-action">Browse</span>
      </summary>

      <div class="index-content">
        <div class="brand">
          <h1>DS Notes</h1>
          <p>Problem cards for revision, intuition, and interview recall.</p>
        </div>

        <label class="search">
          <span class="label">Search</span>
          <input id="searchInput" type="search" placeholder="problem, pattern, gotcha..." />
        </label>

        <div class="filters" id="patternFilters" aria-label="Pattern filters"></div>
        <nav class="problem-list" id="problemList" aria-label="Problems"></nav>
      </div>
    </details>
  </aside>

  <section class="workspace" aria-live="polite">
    <article class="notebook-page">
      <header class="problem-header">
        <div>
          <p class="kicker" id="problemSource">{initialProblem.source.name}</p>
          <h2 id="problemTitle">{initialProblem.title}</h2>
          <p class="summary" id="problemSummary">{initialProblem.summary}</p>
        </div>
        <div class="meta-panel" id="metaPanel">
          <div class="meta-item">
            <span class="label">Source</span>
            <a href={initialProblem.source.url} target="_blank" rel="noreferrer" title={initialProblem.source.name}>
              {sourceLabel}
            </a>
          </div>
          {canonical && (
            <div class="meta-item">
              <span class="label">Canonical</span>
              <a href={canonical.url} target="_blank" rel="noreferrer" title={canonical.title}>
                {canonical.platform} {canonical.number}
              </a>
            </div>
          )}
          <div class="meta-item">
            <span class="label">Level</span>
            <strong>{initialProblem.difficulty}</strong>
          </div>
          <div class="meta-item">
            <span class="label">Note</span>
            <a href={`/${initialProblem.notePath}`} title={initialProblem.notePath}>Markdown</a>
          </div>
        </div>
      </header>

      <section class="approach-note" aria-label="Approach">
        <h3>Approach</h3>
        <div class="approach-copy" id="approachText">
          {initialProblem.approach.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="study-strip" aria-label="Study snapshot">
        <div>
          <span class="label">Pattern</span>
          <strong id="patternText">{initialProblem.patternSummary ?? initialProblem.patterns.join(" + ")}</strong>
        </div>
        <div>
          <span class="label">Invariant</span>
          <strong id="invariantText">{initialProblem.invariant}</strong>
        </div>
        <div>
          <span class="label">Avoid</span>
          <strong id="gotchaText">{initialProblem.gotchas[0] ?? "-"}</strong>
        </div>
      </section>

      <div class="revision-layout">
        <section class="card-stage" aria-label="Flashcards">
          <div class="card-toolbar">
            <div>
              <span class="label">Flashcard</span>
              <strong id="cardCounter">1 / {initialProblem.cards.length}</strong>
            </div>
            <div class="toolbar-actions">
              <button id="prevCard" type="button" aria-label="Previous card">‹</button>
              <button id="revealCard" type="button" aria-controls="cardAnswer" aria-expanded="false">Reveal</button>
              <button id="nextCard" type="button" aria-label="Next card">›</button>
            </div>
          </div>

          <div class="flashcard-stack">
            <div class="deck-layer deck-layer-one" aria-hidden="true"></div>
            <div class="deck-layer deck-layer-two" aria-hidden="true"></div>
            <article class="flashcard">
              <p class="card-question" id="cardQuestion">{initialCard.question}</p>
              <div class="card-answer" id="cardAnswer" role="region" aria-labelledby="cardQuestion" hidden>
                {initialCard.answer}
              </div>
            </article>
          </div>
        </section>

        <aside class="question-bank" aria-label="Question bank">
          <div class="section-heading">
            <span class="label">Recall Path</span>
            <strong id="questionCount">{initialProblem.cards.length} cards</strong>
          </div>
          <ol id="questionList">
            {initialProblem.cards.map((card, index) => (
              <li>
                <button type="button" class="question-jump" aria-current={String(index === 0)}>
                  <span class="question-cue">{card.cue ?? `Card ${index + 1}`}</span>
                  <span class="question-text">{card.question}</span>
                </button>
              </li>
            ))}
          </ol>
        </aside>
      </div>

      <section class="solution-sheet" aria-label="Reference solution">
        <div class="section-heading">
          <span class="label">Reference Code</span>
          <strong id="solutionLanguage">{initialProblem.solutionLanguage}</strong>
        </div>
        <pre class="code-block"><code id="solutionCode"></code></pre>
      </section>

      <section class="notes-grid" aria-label="Problem notes">
        <article>
          <h3>Approach Memory</h3>
          <div class="note-copy" id="ahaList">
            {initialProblem.ahaClicks.map((note) => <p>{note}</p>)}
          </div>
        </article>
        <article>
          <h3>Recall Checks</h3>
          <div class="note-copy" id="reviewList">
            {initialProblem.reviewPrompts.map((note) => <p>{note}</p>)}
          </div>
        </article>
      </section>
    </article>
  </section>
</main>

<script define:vars={{ problems }}>
  window.DS_NOTES_PROBLEMS = problems;
</script>
<script type="module" src="/scripts/app.js"></script>
